{
  "name": "retro-ski-jumping",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vite build && playwright test tests/browser/competition.spec.ts tests/browser/jump.spec.ts tests/browser/persistence.spec.ts tests/browser/shell.spec.ts",
    "test:capture": "vite build && playwright test z_capture",
    "test:benchmark": "vite build && playwright test tests/browser/benchmark.spec.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.10.1",
    "fake-indexeddb": "6.2.5",
    "pdf-parse": "^2.4.5",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
